{
  "id": "tuya_ts0044",
  "name": "Tuya TS0044 wireless switch (4 buttons)",
  "device": {
    "vendor": "Tuya",
    "model": "TS0044",
    "description": "Wireless switch with 4 buttons",
    "type": "Remote",
