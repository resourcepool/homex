    },
    {
      "id": 13,
      "profileId": 49246,
      "deviceId": 57694,
      "inClusters": [
        "touchlink"
      ],
      "outClusters": [
        "touchlink"
      ]
    }
  ],
  "routineTemplates": [
    {
      "name": "Wall switch off and on every 2 minutes",
      "loop": true,
      "steps": [
        {
          "kind": "wait",
          "ms": 120000
        },
        {
          "kind": "gesture",
          "control": "mains",
          "gesture": "off"
        },
        {
          "kind": "wait",
          "ms": 5000
        },
        {
          "kind": "gesture",
          "control": "mains",
          "gesture": "on"
        }
      ]
    }
