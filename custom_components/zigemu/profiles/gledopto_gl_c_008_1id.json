    "logicalType": "router",
    "rxOnWhenIdle": true,
    "manufacturerCode": 4687,
    "macCapabilities": 142,
    "ieeePrefix": "00124b0"
  },
  "endpoints": [
    {
      "id": 11,
      "profileId": 49246,
      "deviceId": 528,
      "inClusters": [
        "genBasic",
        "genIdentify",
        "genGroups",
        "genScenes",
        "genOnOff",
        "genLevelCtrl",
        "lightingColorCtrl"
      ],
      "outClusters": [
        "genOta"
      ],
      "serverOptions": {
        "lightingColorCtrl": {
          "capabilities": [
