      "use": "color",
      "endpoint": 11
    },
    {
      "id": "mains",
      "use": "power",
      "description": "Mains / wall switch. On power-up the light applies its power-on behaviour (startUpOnOff, startUpCurrentLevel, startUpColorTemperature) and re-announces."
    }
  ]
