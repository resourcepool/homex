              "uint8",
              32
            ],
            [
              "uint8",
              "{{ value }}"
            ]
          ]
        }
      }
    ],
    "attr:manuSpecificLumi:0x013c": [
      {
        "send": {
          "endpoint": 1,
          "cluster": "manuSpecificLumi",
          "command": 10,
          "clusterSpecific": false,
          "manufacturerCode": 4447,
          "disableDefaultResponse": true,
          "payload": [
            [
              "uint16",
              316
            ],
            [
              "uint8",
              32
            ],
            [
              "uint8",
              "{{ value }}"
            ]
          ]
        }
      }
    ],
    "attr:manuSpecificLumi:0x0126": [
      {
        "send": {
          "endpoint": 1,
          "cluster": "manuSpecificLumi",
          "command": 10,
          "clusterSpecific": false,
          "manufacturerCode": 4447,
          "disableDefaultResponse": true,
          "payload": [
            [
              "uint16",
              294
            ],
            [
              "uint8",
              32
            ],
            [
              "uint8",
              "{{ value }}"
            ]
          ]
        }
      }
    ]
  },
  "routineTemplates": [
    {
      "name": "Burnt toast: smoke for 1 minute every 10 minutes",
      "loop": true,
      "steps": [
        {
          "kind": "gesture",
          "control": "smoke",
          "gesture": "smoke"
        },
        {
          "kind": "wait",
          "ms": 60000
        },
        {
          "kind": "gesture",
          "control": "smoke",
          "gesture": "clear"
        },
        {
          "kind": "wait",
          "ms": 540000
        }
      ]
    }
  ],
  "controls": [
    {
      "id": "smoke_state",
      "type": "indicator",
      "label": "Smoke",
      "icon": "flame",
      "value": "{{ ('SMOKE · density ' + str(attr('manuSpecificLumi', 'smokeDensity'))) if attr('manuSpecificLumi', 'smoke') else 'clear' }}",
      "on": "{{ attr('manuSpecificLumi', 'smoke') == 1 }}"
    },
    {
      "id": "test_state",
      "type": "indicator",
      "label": "Self-test",
      "icon": "alert",
      "value": "{{ 'testing' if attr('manuSpecificLumi', 'selfTest') else 'idle' }}",
      "on": "{{ attr('manuSpecificLumi', 'selfTest') }}"
    },
    {
      "id": "enrolled",
      "type": "indicator",
      "label": "IAS",
      "icon": "link",
      "value": "{{ ('zone ' + str(attr('ssIasZone', 'zoneId'))) if attr('ssIasZone', 'zoneState') else 'not enrolled' }}",
      "on": "{{ attr('ssIasZone', 'zoneState') == 1 }}"
    },
    {
      "id": "battery_state",
      "type": "indicator",
      "label": "Battery",
      "icon": "battery",
      "value": "{{ attr('genPowerCfg', 'batteryPercentageRemaining') // 2 }} %"
    },
    {
      "id": "smoke",
      "use": "smoke",
      "value": "{{ 'smoke' if attr('manuSpecificLumi', 'smoke') else 'clear' }}",
      "on": {
        "smoke": [
          {
            "macro": "smoke",
            "vars": {
              "on": 1,
              "density": 6
            }
          }
        ],
        "clear": [
          {
            "macro": "smoke",
            "vars": {
              "on": 0,
              "density": 0
            }
          }
        ]
      },
      "description": "Smoke in the chamber: alarm (smoke = 1, density 6) or clear."
    },
    {
      "id": "test_button",
      "type": "button",
      "label": "Test",
      "icon": "alert",
      "description": "The button on the detector: starts the self-test (LED + buzzer), like the host's selftest.",
      "holdDelay": 3000,
      "holdInterval": 60000,
      "on": {
        "press": [
          {
            "setAttribute": {
              "cluster": "manuSpecificLumi",
              "attributes": {
                "selfTest": true
              }
            }
          }
        ]
      }
    },
    {
      "id": "battery",
      "use": "battery",
      "also": {
        "change": [
          {
            "macro": "heartbeat"
          }
        ]
      }
    }
  ]
}
