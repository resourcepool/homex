{
  "id": "aqara_jy_gz_01aq",
  "name": "Aqara smart smoke detector (JY-GZ-01AQ)",
  "device": {
    "vendor": "Aqara",
    "model": "JY-GZ-01AQ",
    "description": "Smart smoke detector",
    "type": "Smoke detector",
    "image": "https://www.zigbee2mqtt.io/images/devices/JY-GZ-01AQ.png",
    "links": [
      {
        "label": "Zigbee2MQTT",
        "url": "https://www.zigbee2mqtt.io/devices/JY-GZ-01AQ.html"
      },
      {
        "label": "ZHA quirk",
        "url": "https://github.com/zigpy/zha-device-handlers/blob/dev/zhaquirks/xiaomi/aqara/smoke.py"
      }
    ]
  },
  "_sources": "zhaquirks xiaomi/aqara/smoke.py signature: LUMI / lumi.sensor_smoke.acn03, ep1 profile 260 device 0x0402 in [0,1,3,0x0500] out [0x0019]; node descriptor end device, manufacturer 0x115F, mac 0x80. Smoke/density/self-test/buzzer/linkage live on the hidden manuSpecificLumi 0xFCC0 (0x013A smoke, 0x013B density 0-10, 0x0127 self-test, 0x0126/0x013D/0x013E buzzer, 0x014B/0x014C linkage) read and written with manufacturer code 0x115F (Z2M lumi.js JY-GZ-01AQ, lib/lumi.js 294-332); smoke also as IAS zone alarm1 (fz.ias_smoke_alarm_1); battery from the 0x00F7 heartbeat TLV (tag 1 = mV) and genPowerCfg batteryVoltage (2.475-3.0 V). Basic versions inferred.",
  "node": {
    "logicalType": "end_device",
    "rxOnWhenIdle": false,
    "manufacturerCode": 4447,
    "macCapabilities": 128,
    "ieeePrefix": "54ef44"
  },
  "endpoints": [
    {
      "id": 1,
      "profileId": 260,
      "deviceId": 1026,
      "inClusters": [
        "genBasic",
        "genPowerCfg",
        "genIdentify",
        "ssIasZone"
      ],
      "outClusters": [
        "genOta"
      ],
      "serverOptions": {
        "ssIasZone": {
          "zoneType": 40
        }
      },
      "attributes": {
        "genBasic": {
          "zclVersion": 3,
          "appVersion": 25,
          "hwVersion": 1,
          "manufacturerName": "LUMI",
          "modelId": "lumi.sensor_smoke.acn03",
          "powerSource": 3,
          "dateCode": "20220623",
          "swBuildId": "0.0.0_0019"
        },
        "genPowerCfg": {
          "batteryVoltage": 30,
          "batteryPercentageRemaining": 200
        },
        "manuSpecificLumi": {
          "buzzerManualMute": {
            "type": "uint8",
            "value": 0,
            "writable": true
          },
          "selfTest": {
            "type": "bool",
            "value": false,
            "writable": true
          },
          "smoke": {
            "type": "uint8",
            "value": 0
          },
          "smokeDensity": {
            "type": "uint8",
            "value": 0
          },
          "heartbeatIndicator": {
            "type": "uint8",
            "value": 0,
            "writable": true
          },
          "buzzerManualAlarm": {
            "type": "uint8",
            "value": 0,
            "writable": true
          },
          "buzzer": {
            "type": "uint32",
            "value": 0,
            "writable": true
          },
          "linkageAlarm": {
            "type": "uint8",
            "value": 0,
            "writable": true
          },
          "linkageAlarmState": {
            "type": "uint8",
            "value": 0
          }
        }
      }
    }
  ],
  "macros": {
    "heartbeat": {
      "description": "Lumi heartbeat: report 0x00F7 (octet string of TLVs: 0x01 battery mV u16, 0x05 power outage count u16), every 50 min.",
      "actions": [
        {
          "send": {
            "endpoint": 1,
            "cluster": "manuSpecificLumi",
            "command": 10,
            "clusterSpecific": false,
            "manufacturerCode": 4447,
            "disableDefaultResponse": true,
            "payload": [
              [
                "uint16",
                247
              ],
              [
                "uint8",
                65
              ],
              [
                "uint8",
                8
              ],
              [
                "uint8",
                1
              ],
              [
                "uint8",
                33
              ],
              [
                "uint16",
                "{{ 2475 + attr('genPowerCfg', 'batteryPercentageRemaining') * 525 // 200 }}"
              ],
              [
                "uint8",
                5
              ],
              [
                "uint8",
                33
              ],
              [
                "uint16",
                1
              ]
            ]
          }
        },
        {
          "schedule": {
            "id": "heartbeat",
            "after": 3000000,
            "do": [
              {
                "macro": "heartbeat"
              }
            ]
          }
        }
      ]
    },
    "smoke": {
      "description": "Smoke detected / cleared: Lumi attributes (reported with manufacturer code) + IAS zone alarm1.",
      "actions": [
        {
          "setAttribute": {
            "cluster": "manuSpecificLumi",
            "attributes": {
              "smoke": "{{ on }}",
              "smokeDensity": "{{ density }}"
            }
          }
        },
        {
          "send": {
            "endpoint": 1,
            "cluster": "manuSpecificLumi",
            "command": 10,
            "clusterSpecific": false,
            "manufacturerCode": 4447,
            "disableDefaultResponse": true,
            "payload": [
              [
                "uint16",
                314
              ],
              [
                "uint8",
                32
              ],
              [
                "uint8",
                "{{ on }}"
              ],
              [
                "uint16",
                315
              ],
              [
                "uint8",
                32
              ],
              [
                "uint8",
                "{{ density }}"
              ]
            ]
          }
        },
        {
          "command": {
            "cluster": "ssIasZone",
            "name": "alarm1",
            "args": {
              "on": "{{ on == 1 }}"
            }
          }
        },
        {
          "if": "{{ attr('manuSpecificLumi', 'linkageAlarm') }}",
          "setAttribute": {
            "cluster": "manuSpecificLumi",
            "attributes": {
              "linkageAlarmState": "{{ on }}"
            }
          }
        },
        {
          "if": "{{ attr('manuSpecificLumi', 'linkageAlarm') }}",
          "send": {
            "endpoint": 1,
            "cluster": "manuSpecificLumi",
            "command": 10,
            "clusterSpecific": false,
            "manufacturerCode": 4447,
            "disableDefaultResponse": true,
            "payload": [
              [
                "uint16",
                332
              ],
              [
                "uint8",
                32
              ],
              [
                "uint8",
                "{{ on }}"
              ]
            ]
          }
        }
      ]
    }
  },
  "events": {
    "joined": [
      {
        "macro": "heartbeat"
      }
    ],
    "attr:manuSpecificLumi:0x0127": [
      {
        "if": "{{ value }}",
        "send": {
          "endpoint": 1,
          "cluster": "manuSpecificLumi",
          "command": 10,
          "clusterSpecific": false,
          "manufacturerCode": 4447,
          "disableDefaultResponse": true,
          "payload": [
            [
              "uint16",
              295
            ],
            [
              "uint8",
              16
            ],
            [
              "bool",
              1
            ]
          ]
        }
      },
      {
        "if": "{{ value }}",
        "schedule": {
          "id": "selftest",
          "after": 3000,
          "do": [
            {
              "setAttribute": {
                "cluster": "manuSpecificLumi",
                "attributes": {
                  "selfTest": false
                }
              }
            },
            {
              "send": {
                "endpoint": 1,
                "cluster": "manuSpecificLumi",
                "command": 10,
                "clusterSpecific": false,
                "manufacturerCode": 4447,
                "disableDefaultResponse": true,
                "payload": [
                  [
                    "uint16",
                    295
                  ],
                  [
                    "uint8",
                    16
                  ],
                  [
                    "bool",
                    0
                  ]
                ]
              }
            }
          ]
        }
      }
    ],
    "attr:manuSpecificLumi:0x014b": [
      {
        "send": {
          "endpoint": 1,
