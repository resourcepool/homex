{
  "id": "philips_rdm002",
  "name": "Philips Hue Tap dial switch",
  "device": {
    "vendor": "Philips",
    "model": "8719514440937/8719514440999",
    "description": "Hue Tap dial switch",
    "type": "Remote",
    "image": "https://www.zigbee2mqtt.io/images/devices/8719514440937-8719514440999.png",
    "links": [
      {
        "label": "Zigbee2MQTT",
